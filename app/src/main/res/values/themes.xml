<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CiaLauncher" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryDark">@color/bg_deep</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="bottomSheetDialogTheme">@style/CiaBottomSheetDialog</item>
    </style>

    <style name="CiaBottomSheetDialog" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CiaBottomSheet</item>
    </style>

    <style name="CiaBottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/CiaSheetShape</item>
        <item name="backgroundTint">@color/card_solid</item>
    </style>

    <style name="CiaSheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="Theme.CiaLauncher.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">@color/card_solid</item>
        <item name="android:windowBackground">@color/card_solid</item>
        <item name="android:textColorPrimary">@color/text_white</item>
    </style>
</resources>
